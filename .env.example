# Dataset Root Directory (Relative to project root or absolute path)
DATASET_ROOT=archive/findit2

# Tesseract OCR Executable Path
# Common Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave blank or commented out if tesseract is in your system PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Model and Outputs Directories
MODELS_DIR=models
OUTPUTS_DIR=outputs
CACHE_DIR=data/cache

# Model Checkpoints (Relative to MODELS_DIR or absolute paths)
CLASSICAL_MODEL_FILE=document_verifier.joblib
VISUAL_MODEL_FILE=visual_verifier_resnet18.pt

# Flask API Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
